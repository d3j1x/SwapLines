
{
  "name": "swaplines",
  "displayName": "SwapLines",
  "description": "Quickly swap two lines of code using a keyboard shortcut.",
  "version": "0.0.1",
  "publisher": "d3j1x",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3j1x/SwapLines.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "swaplines.swap",
        "title": "SwapLines: Swap Two Lines"
      }
    ],
    "keybindings": [
      {
        "command": "swaplines.swap",
        "key": "ctrl+alt+s",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
